# Contact string embedded in the scraper's User-Agent header - a real project/team
# contact, not personal info, so a target site's admin can identify and reach us if
# needed. This is "good scraper citizenship," not evasion - never leave this blank
# or fake for anything that isn't a local sandbox test.
SCRAPER_CONTACT=cybersafe2026-capstone-team@example.com

# NVD API key (Week 1 TODO: request one at https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Optional Week 8-9 stretch
SECURITYTRAILS_API_KEY=

# The project's one outbound email sender (backend/app/email_sender.py) - used by both
# the weekly registration digest AND the team dashboard's passkey enrollment links.
# A Gmail account with an App Password (Google Account > Security > 2-Step Verification
# > App Passwords), not your real Gmail login. Never commit the real value - this file
# is gitignored, but double check before pasting a real password anywhere else.
DIGEST_SENDER_EMAIL=
DIGEST_SENDER_APP_PASSWORD=
# Comma-separated - everyone who should get the weekly registration summary
DIGEST_RECIPIENTS=

# Team passkey dashboard (backend/app/auth/passkeys.py) - only needed if you're running
# this locally on something other than the real cybersafe.codynoah.net domain (WebAuthn
# ties a passkey to one exact origin). Leave blank in production; for local dev try:
#   WEBAUTHN_RP_ID=localhost
#   WEBAUTHN_ORIGIN=http://localhost:8000
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
